# Syncrade Environment Configuration Template
# Copy this file to .env (backend) or .env.local (frontend) and fill in your values
# DO NOT commit .env or .env.local to git

# =============================================================================
# Backend API Configuration (Python)
# =============================================================================

# Server
API_PORT=8000
API_HOST=0.0.0.0
PYTHON_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Python/ASGI
UVICORN_WORKERS=4
UVICORN_RELOAD=true

# =============================================================================
# Data Sources
# =============================================================================

# Blockchain RPC
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://mainnet.base.org
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Price Data
PRICE_API_KEY=your_coingecko_api_key
PRICE_API_URL=https://api.coingecko.com/v3

# Onchain Data (if using indexer)
# INDEXER_API_URL=https://indexer.your-domain.com
# INDEXER_API_KEY=your_indexer_key

# =============================================================================
# LLM Configuration
# =============================================================================

LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.0

# Canonical Model Set (from Model Binding Clause v1)
LLM_MODEL_PRIMARY_REASONER=gpt-5.2
LLM_MODEL_LOW_COST_RENDERER=gpt-5-mini
LLM_MODEL_NANO_ROUTER=gpt-5-nano

# Model Versioning (for Determinism Guard)
# LLM_MODEL_VERSION_HASH=...  # Hash of model version for replay
# LLM_PROMPT_TEMPLATE_HASH=...  # Hash of prompt template for replay

# Cost Discipline
LLM_PRIMARY_REASONER_BUDGET=1000  # Budget per query (tokens or cost)
LLM_AUTO_DEGRADE_TO_MINI=true
LLM_MAX_CALLS_PER_REQUEST=2
LLM_FALLBACK_ENABLED=true

# OpenAI Python SDK (uses this env var)
OPENAI_API_KEY=${LLM_API_KEY}

# =============================================================================
# Resource Limits (from security-abuse-protocol-v1.md)
# =============================================================================

MAX_TOOL_CALLS_PER_REQUEST=8
MAX_WINDOW_SPAN_DAYS=180
MAX_RETURNED_OBJECTS=25
MAX_REQUEST_SIZE_KB=100

# =============================================================================
# Rate Limiting (from security-abuse-protocol-v1.md)
# =============================================================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_BURST=10
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_WINDOW_MS=60000

# =============================================================================
# Storage (Optional - uncomment if using)
# =============================================================================

# Database (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/syncrade
# DATABASE_POOL_SIZE=10
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Cache (Redis)
# REDIS_URL=redis://localhost:6379
# REDIS_TTL_SECONDS=3600
# REDIS_DB=0

# Object Storage (S3)
# S3_BUCKET=syncrade-snapshots
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# =============================================================================
# Observability
# =============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
# LOG_FILE=/var/log/syncrade/api.log

PYTHON_LOG_LEVEL=INFO
PYTHON_LOG_FORMAT=json

TRACE_ENABLED=true
TRACE_SAMPLE_RATE=1.0
TRACE_EXPORTER=console

METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# Security
# =============================================================================

# API Keys (if using API key authentication)
# API_KEY_HEADER=X-API-Key
# API_KEYS=key1,key2,key3

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST
CORS_HEADERS=Content-Type,Authorization

# HTTPS (if terminating at app)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# =============================================================================
# Morpheus API
# =============================================================================

MORPHEUS_API_URL=https://api.morpheus.com
MORPHEUS_API_KEY=sk-dgaieS.c30e5fefe35601e03dbcecea1d79b24eba45dd82e53e3cc66c1a593ada71300a
# MORPHEUS_API_VERSION=v1  # if applicable
