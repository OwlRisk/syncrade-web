{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "syncrade://schemas/query-intent-v1.schema.json",
  "title": "QueryIntentV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["intent", "entities", "time_window", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["WALLET_ANALYZE", "TOKEN_ANALYZE", "TX_ANALYZE", "QUESTION"]
    },
    "entities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wallets": { "type": "array", "items": { "type": "string" } },
        "tokens": { "type": "array", "items": { "type": "string" } },
        "txs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "time_window": {
      "type": "string",
      "enum": ["D7", "D30", "D180", "UNSPECIFIED"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "fallback_reason": { "type": "string" }
  }
}


