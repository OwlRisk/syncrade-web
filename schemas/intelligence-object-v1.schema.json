{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "syncrade://schemas/intelligence-object-v1.schema.json",
  "title": "IntelligenceObjectV1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "type",
    "subject",
    "window",
    "model",
    "inference",
    "uncertainty",
    "uncertainty_method",
    "evidence",
    "data_timestamp",
    "expires_at",
    "replay",
    "safety_notice"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["OBSERVATION", "SIGNAL", "INSIGHT", "RISK", "BEHAVIOR"]
    },
    "subject": { "type": "object" },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["pipeline_version"],
      "properties": {
        "pipeline_version": { "type": "string" },
        "rule_version": { "type": "string" },
        "scoring_version": { "type": "string" },
        "params_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inference": { "type": ["object", "string"] },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty_method": {
      "type": "string",
      "enum": ["RULE_CALIBRATED", "DATA_QUALITY_GATED", "STATISTICAL_CALIBRATION"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_method": { "type": "string", "enum": ["ONE_MINUS_UNCERTAINTY"] },
    "invalidations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Evidence" }
    },
    "data_timestamp": { "type": "string" },
    "expires_at": { "type": "string" },
    "replay": {
      "type": "object",
      "required": ["replay_key", "replay_inputs", "evidence_hash", "dataset_snapshot"],
      "properties": {
        "replay_key": { "type": "string" },
        "replay_hash": { "type": "string" },
        "dataset_snapshot": { "type": "string" },
        "evidence_hash": { "type": "string" },
        "replay_inputs": { "type": "object" }
      },
      "additionalProperties": true
    },
    "safety_notice": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "SIGNAL" } } },
      "then": { "required": ["invalidations"] }
    }
  ],
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": ["source", "metric", "value", "timestamp"],
      "properties": {
        "source": { "type": "string" },
        "metric": { "type": "string" },
        "value": {},
        "delta": {},
        "baseline": {},
        "timestamp": { "type": "string" },
        "reference_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}


